# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS base

ENV NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

WORKDIR /app

FROM base AS dependencies

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json

RUN npm ci

FROM dependencies AS builder

COPY frontend/ ./frontend/

# Ensure the optional public directory exists for the runtime COPY.
RUN mkdir -p frontend/public \
    && npm run build \
    && rm -rf frontend/.next/cache

FROM dependencies AS production-dependencies

RUN npm prune --omit=dev --ignore-scripts

FROM base AS runner

ENV NODE_ENV=production \
    PORT=3000

# Preserve npm workspace links and any nested production dependencies.
COPY --from=production-dependencies /app/ ./
COPY --from=builder --chown=node:node /app/frontend/.next ./frontend/.next
COPY --from=builder /app/frontend/public ./frontend/public

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/', { signal: AbortSignal.timeout(3000) }).then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

# Run Node directly so Next.js receives container shutdown signals.
CMD ["node", "node_modules/next/dist/bin/next", "start", "frontend", "--hostname", "0.0.0.0"]
