# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    U2NET_HOME=/opt/models \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    HOME=/home/app \
    PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /opt/models /tmp/ultralytics \
    && chown app:app /opt/models /tmp/ultralytics

COPY requirements.txt ./

# Install CPU wheels first to avoid pulling CUDA libraries through Ultralytics.
RUN python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install -r requirements.txt \
    && python -m pip check

USER app

# Download without loading inference into memory; cache this layer across code changes.
RUN python -c "from rembg.sessions.birefnet_portrait import BiRefNetSessionPortrait; BiRefNetSessionPortrait.download_models()"

COPY best.pt ./best.pt
COPY src/ ./src/

RUN PYTHONPATH=src python -c "import main"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + (os.environ.get('PORT') or '8000') + '/health', timeout=3).close()"]

CMD ["sh", "-c", "exec python -m uvicorn main:app --app-dir src --host 0.0.0.0 --port \"${PORT:-8000}\" --workers 1"]
